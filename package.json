		"@types/pg": "^8.15.5",
		"@typescript-eslint/eslint-plugin": "^8.44.1",
		"@typescript-eslint/parser": "^8.44.1",
		"eslint": "^9.36.0",
		"eslint-plugin-prettier": "^5.5.4",
		"prettier": "^3.6.2",
		"tslib": "^2.8.1",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.44.1"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@inquirer/prompts": "^7.8.6",
		"chalk": "^5.6.2",
		"clui": "^0.3.6",
