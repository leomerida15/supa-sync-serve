	},
	"homepage": "https://github.com/leomerida15/supa-sync-serve#readme",
	"version": "1.0.1",
	"description": "A CLI tool for comparing and migrating Supabase database schemas",
	"keywords": [
		"supabase",
		"database",
		"migration",
		"diff",
		"cli",
		"postgresql"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/leomerida15/supa-sync-server.git"
	},
	"bugs": {
		"url": "https://github.com/leomerida15/supa-sync-server/issues"
	},
	"bin": {
		"supa-sync-server": "./dist/index.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist/**/*",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=18.0.0",
		"bun": ">=1.2.22"
	},
	"scripts": {
		"dev": "bun run src/index.ts",
		"start": "bun run --watch",
		"build": "bun run bunpack.build.ts",
		"prepublishOnly": "bun run build",
		"test": "bun run bunpack.test",
		"lint": "eslint src --ext .ts,.tsx",
		"format": "prettier --write .",
		"clean": "rm -rf dist node_modules/.tmp"
	},
	"devDependencies": {
		"@eslint/js": "^9.36.0",
		"@supabase-kit/supa-sync-serve": "^1.0.0",
		"@types/bun": "latest",
